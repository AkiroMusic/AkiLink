<Window x:Class="AkiLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AkiLink.Models"
        xmlns:views="clr-namespace:AkiLink.Views"
        xmlns:local="clr-namespace:AkiLink"
        Title="AkiLink" Height="650" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main content (sidebar + content area) -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════
             HEADER
             ════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource ThemeSurface}"
                BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppTitle}"
                               Style="{StaticResource HeadingTextStyle}"
                               FontSize="22"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource AppSubtitle}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"
                               Margin="12,2,0,0" />
                </StackPanel>

                <!-- Connection status indicator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                    <TextBlock Text="{Binding ConnectionStateText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             MAIN CONTENT — Sidebar + Content Area
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="Auto" />
                <!-- Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ──── SIDEBAR ──── -->
            <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <!-- Devices / Device List -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="Devices"
                                ToolTip="{DynamicResource NavDevices}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static local:IconGeometries.DevicesIcon}"
                                          Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Devices}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Settings -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="Settings"
                                ToolTip="{DynamicResource NavSettings}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static local:IconGeometries.SettingsIcon}"
                                          Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Settings}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- History -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="History"
                                ToolTip="{DynamicResource NavHistory}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static local:IconGeometries.HistoryIcon}"
                                          Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=History}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- Mini mode -->
                        <Rectangle Height="1" Fill="{StaticResource ThemeBorder}" Margin="6,8,6,8" />
                        <Button Command="{Binding ToggleCompactModeCommand}"
                                ToolTip="{DynamicResource CompactModeTooltip}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{x:Static local:IconGeometries.MiniModeIcon}"
                                          Fill="{Binding IsCompactMode, Converter={StaticResource BoolToBrushConverter}}" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
            </Border>

            <!-- ──── CONTENT AREA ──── -->
            <Grid Grid.Column="1">

                <!-- ═══ DEVICES VIEW ═══ -->
                <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=Devices}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: DEVICE LIST ── -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0"
                            Margin="20,16,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0" Padding="16,14,16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource DevicesTitle}"
                                               Style="{StaticResource SubheadingTextStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Devices.Count" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Command="{Binding RefreshDevicesCommand}"
                                                Content="{DynamicResource DeviceRefresh}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Height="32"
                                                Padding="14,0"
                                                FontSize="12"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scanning overlay -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource ThemeOverlay}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                    CornerRadius="8"
                                    Margin="8,0,8,8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource DevicesScanning}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,40,0,40" />
                            </Border>

                            <!-- Device list -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     Style="{StaticResource ModernListBoxStyle}"
                                     Margin="8,0,8,8"
                                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BluetoothDeviceInfo}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource ThemeText}" />
                                                <TextBlock Text="{Binding Kind}"
                                                           Style="{StaticResource SmallTextStyle}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty state -->
                            <Border Grid.Row="1"
                                    Visibility="{Binding HasDevices, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                    CornerRadius="8"
                                    Margin="8,0,8,8">
                                <TextBlock Text="{DynamicResource DevicesEmpty}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="20" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Column spacer -->
                    <Grid Grid.Column="1" />

                    <!-- ── RIGHT: CONNECTION + VOLUME ── -->
                    <ScrollViewer Grid.Column="2"
                                  Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,16,20,12">
                        <StackPanel>
                            <!-- ── CONNECTION CARD ── -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ConnectionTitle}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />

                                    <!-- Selected device info -->
                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding SelectedDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{DynamicResource DeviceLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding SelectedDevice.Name}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{DynamicResource StatusLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding ConnectionStateText}"
                                                   Foreground="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}"
                                                   FontWeight="SemiBold"
                                                   Margin="10,4,0,0" />
                                    </Grid>

                                    <!-- Connect / Disconnect buttons -->
                                    <Button Command="{Binding ConnectCommand}"
                                            Content="{DynamicResource ConnectBtn}"
                                            Style="{StaticResource ConnectButtonStyle}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                            Margin="0,0,0,8" />
                                    <Button Command="{Binding DisconnectCommand}"
                                            Content="{DynamicResource DisconnectBtn}"
                                            Style="{StaticResource DisconnectButtonStyle}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <!-- ── VOLUME CARD ── -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource VolumeTitle}"
                                                   Style="{StaticResource SubheadingTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <Binding Path="Volume" StringFormat="{}{0:P0}" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Volume slider -->
                                    <Slider Value="{Binding Volume, Mode=TwoWay}"
                                            Minimum="0"
                                            Maximum="1"
                                            Style="{StaticResource ModernSliderStyle}"
                                            TickFrequency="0.01"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,0,0,12" />

                                    <!-- Mute button -->
                                    <Button Command="{Binding ToggleMuteCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Height="36"
                                            Padding="14,0">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Mute}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Unmute}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- ── AUTO-RECONNECT CARD ── -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource AutoReconnect}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource AutoReconnectDesc}"
                                                   Style="{StaticResource SmallTextStyle}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding AutoReconnect}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- ── QUALITY GUIDE CARD ── -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource QualityGuideTitle}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,8" />
                                    <TextBlock Text="{DynamicResource QualityGuideDesc}"
                                               Style="{StaticResource SmallTextStyle}"
                                               TextWrapping="Wrap"
                                               LineHeight="18" />
                                    <Border Background="{StaticResource ThemeSurfaceAlt}"
                                            CornerRadius="6"
                                            Padding="12,10"
                                            Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource ThemeAccent}">
                                                <Run Text="{DynamicResource QualityGuideSetting1}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SmallTextStyle}"
                                                       Margin="0,4,0,0">
                                                <Run Text="{DynamicResource QualityGuideSetting2}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource QualityGuideHint}"
                                               Style="{StaticResource SmallTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               LineHeight="18" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ SETTINGS VIEW ═══ -->
                <views:SettingsPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=Settings}" />

                <!-- ═══ HISTORY VIEW ═══ -->
                <views:HistoryPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=History}" />

                <!-- ═══ COMPACT MODE OVERLAY ═══ -->
                <Border Style="{StaticResource CompactOverlayStyle}"
                        Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <!-- Large status indicator -->
                        <Ellipse Width="32" Height="32"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,12"
                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}" />

                        <!-- Device name (or prompt) -->
                        <TextBlock Text="{Binding SelectedDevice.Name}"
                                   Style="{StaticResource CompactDeviceNameStyle}" />

                        <!-- Codec / quality info -->
                        <TextBlock Text="{Binding CodecDisplayText, TargetNullValue=''}"
                                   Style="{StaticResource CompactCodecStyle}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Connection state -->
                        <TextBlock Text="{Binding ConnectionStateText}"
                                   FontSize="12"
                                   Foreground="{StaticResource ThemeTextSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />

                        <!-- Volume in compact mode -->
                        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource VolumeTitle}"
                                           FontSize="12"
                                           Foreground="{StaticResource ThemeTextSecondary}" />
                                <TextBlock Grid.Column="1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ThemeText}">
                                    <TextBlock.Text>
                                        <Binding Path="Volume" StringFormat="{}{0:P0}" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                            <Slider Value="{Binding Volume, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    Height="28" />
                        </StackPanel>

                        <!-- Mute + Disconnect row -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <Button Command="{Binding ToggleMuteCommand}"
                                    Content="{DynamicResource Mute}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Height="34" Padding="16,0"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding ToggleCompactModeCommand}"
                                    Content="{DynamicResource CompactModeExit}"
                                    Style="{StaticResource ConnectButtonStyle}"
                                    Height="34" Padding="16,0"
                                    FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════
             STATUS BAR
             ════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource ThemeSurfaceAlt}"
                BorderBrush="{StaticResource ThemeBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Quality indicator (visible when connected) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Signal strength bars -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Height="16">
                        <Rectangle Width="3" Height="6"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{StaticResource BrushStatusConnected}">
                            <Rectangle.Opacity>
                                <Binding Path="SignalStrengthPercent" Converter="{StaticResource PercentToSignalOpacityConverter}" ConverterParameter="1" />
                            </Rectangle.Opacity>
                        </Rectangle>
                        <Rectangle Width="3" Height="10"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{StaticResource BrushStatusConnected}">
                            <Rectangle.Opacity>
                                <Binding Path="SignalStrengthPercent" Converter="{StaticResource PercentToSignalOpacityConverter}" ConverterParameter="2" />
                            </Rectangle.Opacity>
                        </Rectangle>
                        <Rectangle Width="3" Height="14"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{StaticResource BrushStatusConnected}">
                            <Rectangle.Opacity>
                                <Binding Path="SignalStrengthPercent" Converter="{StaticResource PercentToSignalOpacityConverter}" ConverterParameter="3" />
                            </Rectangle.Opacity>
                        </Rectangle>
                        <Rectangle Width="3" Height="16"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0,4,0"
                                   Fill="{StaticResource BrushStatusConnected}">
                            <Rectangle.Opacity>
                                <Binding Path="SignalStrengthPercent" Converter="{StaticResource PercentToSignalOpacityConverter}" ConverterParameter="4" />
                            </Rectangle.Opacity>
                        </Rectangle>
                    </StackPanel>

                    <!-- Codec / quality text -->
                    <TextBlock Text="{Binding CodecDisplayText}"
                               Style="{StaticResource QualityInfoStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
