<Window x:Class="AkiLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AkiLink.Models"
        xmlns:views="clr-namespace:AkiLink.Views"
        xmlns:local="clr-namespace:AkiLink"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AkiLink.Controls"
        Title="AkiLink" Height="650" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Style="{StaticResource ModernWindowStyle}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="4"
                            CaptionHeight="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>


    <!-- ════════════════════════════════════════
         WINDOW EDGE FRAME
         1px hairline (ThemeBorder #313644) around the whole window
         perimeter, drawn above the content. Collapses to 0 when the
         window is maximized so the frame never renders as an inner
         line against the screen edge (WM_GETMINMAXINFO sizes the
         maximized window to exactly the work area).
         ════════════════════════════════════════ -->
    <Border SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="40" />
            <!-- Main content (sidebar + content area) -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════
              CUSTOM TITLE BAR
              ════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource GlassBackgroundStrong}"
                BorderBrush="{StaticResource GlassBorder}"
                BorderThickness="0,0,0,1"
                Height="40"
                MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window title + app icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Resources/AkiLink.png"
                           Width="18" Height="18"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,10,0">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,18,18" />
                        </Image.Clip>
                    </Image>
                    <TextBlock Text="AkiLink"
                               FontSize="12" Foreground="{StaticResource ThemeText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window control buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="─"
                            ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Content="□"
                            ToolTip="Maximize" />
                    <Button x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Content="✕"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             MAIN CONTENT — Sidebar + Content Area
             ════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="Auto" />
                <!-- Content -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ──── SIDEBAR ──── -->
            <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <!-- Devices -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="Devices"
                                ToolTip="{DynamicResource NavDevices}"
                                Background="{Binding CurrentView, Converter={StaticResource ViewToActiveBackgroundConverter}, ConverterParameter=Devices}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel>
                                <Viewbox Width="21" Height="21">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{x:Static local:IconGeometries.DevicesIcon}"
                                              Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Devices}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource NavDevices}"
                                           FontSize="10"
                                           Foreground="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Devices}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Audio -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="Audio"
                                ToolTip="{DynamicResource NavAudio}"
                                Background="{Binding CurrentView, Converter={StaticResource ViewToActiveBackgroundConverter}, ConverterParameter=Audio}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel>
                                <Viewbox Width="21" Height="21">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{x:Static local:IconGeometries.AudioQualityIcon}"
                                              Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Audio}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource NavAudio}"
                                           FontSize="10"
                                           Foreground="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Audio}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Button Command="{Binding NavigateToViewCommand}"
                                CommandParameter="Settings"
                                ToolTip="{DynamicResource NavSettings}"
                                Background="{Binding CurrentView, Converter={StaticResource ViewToActiveBackgroundConverter}, ConverterParameter=Settings}"
                                Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel>
                                <Viewbox Width="21" Height="21">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{x:Static local:IconGeometries.SettingsIcon}"
                                              Fill="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Settings}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{DynamicResource NavSettings}"
                                           FontSize="10"
                                           Foreground="{Binding CurrentView, Converter={StaticResource ViewToActiveBrushConverter}, ConverterParameter=Settings}"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
            </Border>

            <!-- ──── CONTENT AREA ──── -->
            <Grid Grid.Column="1">

                <!-- ═══ DEVICES VIEW ═══ -->
                <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=Devices}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: DEVICE LIST ── -->
                    <controls:CardBorder Grid.Column="0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="0"
                            Margin="20,16,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Section header -->
                            <Border Grid.Row="0" Padding="16,14,16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource DevicesTitle}"
                                               Style="{StaticResource SubheadingTextStyle}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Devices.Count" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Command="{Binding RefreshDevicesCommand}"
                                                Content="{DynamicResource DeviceRefresh}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Height="32"
                                                Padding="14,0"
                                                FontSize="12"
                                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scanning overlay -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource ThemeOverlay}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                    CornerRadius="8"
                                    Margin="8,0,8,8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{DynamicResource DevicesScanning}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,40,0,40" />
                            </Border>

                            <!-- Device list -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     Style="{StaticResource ModernListBoxStyle}"
                                     Margin="8,0,8,8"
                                     Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:BluetoothDeviceInfo}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <!-- Device name -->
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="{StaticResource ThemeText}" />

                                                <!-- Status row: connected → dot + label + realtime quality -->
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,3,0,0"
                                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Ellipse Width="8" Height="8"
                                                             VerticalAlignment="Center"
                                                             Fill="{StaticResource BrushStatusConnected}" />
                                                    <TextBlock Text="{DynamicResource StatusConnected}"
                                                               Style="{StaticResource SmallTextStyle}"
                                                               Foreground="{StaticResource BrushStatusConnected}"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding DataContext.CodecDisplayText, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               Style="{StaticResource SmallTextStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>

                                                <!-- Status row: not connected → device kind -->
                                                <TextBlock Text="{Binding Kind}"
                                                           Style="{StaticResource SmallTextStyle}"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty state -->
                            <Border Grid.Row="1"
                                    Visibility="{Binding HasDevices, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                    CornerRadius="8"
                                    Margin="8,0,8,8">
                                <TextBlock Text="{DynamicResource DevicesEmpty}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="20" />
                             </Border>
                        </Grid>
                    </controls:CardBorder>

                    <!-- Column spacer -->
                    <Grid Grid.Column="1" />

                    <!-- ── RIGHT: CONNECTION + VOLUME ── -->
                    <ScrollViewer Grid.Column="2"
                                  Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,16,20,12">
                        <StackPanel>
                            <!-- ── CONNECTION CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ConnectionTitle}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />

                                    <!-- Selected device info -->
                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding SelectedDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{DynamicResource DeviceLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding SelectedDevice.Name}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{DynamicResource StatusLabel}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding ConnectionStateText}"
                                                   Foreground="{Binding ConnectionState, Converter={StaticResource ConnectionStateToColorConverter}}"
                                                   FontWeight="SemiBold"
                                                   Margin="10,4,0,0" />
                                    </Grid>

                                    <!-- Connect / Disconnect buttons -->
                                    <Button Command="{Binding ConnectCommand}"
                                            Content="{DynamicResource ConnectBtn}"
                                            Style="{StaticResource ConnectButtonStyle}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                            Margin="0,0,0,8" />
                                    <Button Command="{Binding DisconnectCommand}"
                                            Content="{DynamicResource DisconnectBtn}"
                                            Style="{StaticResource DisconnectButtonStyle}"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </controls:CardBorder>

                            <!-- ── VOLUME CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource VolumeTitle}"
                                                   Style="{StaticResource SubheadingTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource MonoValueTextStyle}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="Volume" StringFormat="{}{0:P0}" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Volume slider
                                         NOTE: SmallChange/LargeChange are REQUIRED because WPF
                                         defaults both to 1.0. With Maximum=1 that clamps
                                         LargeChange to the WHOLE range — clicking the track
                                         once jumps to 0% (DecreaseLarge) or 100% (IncreaseLarge). -->
                                    <Slider Value="{Binding Volume, Mode=TwoWay}"
                                            Minimum="0"
                                            Maximum="1"
                                            SmallChange="0.01"
                                            LargeChange="0.1"
                                            Style="{StaticResource ModernSliderStyle}"
                                            TickFrequency="0.01"
                                            IsSnapToTickEnabled="False"
                                            Margin="0,0,0,12" />

                                    <!-- Mute button -->
                                    <Button Command="{Binding ToggleMuteCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Height="36"
                                            Padding="14,0">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Mute}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="{DynamicResource Unmute}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </controls:CardBorder>

                            <!-- ── LEVEL CARD (live VU meter) ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{DynamicResource LevelTitle}"
                                                   Style="{StaticResource SubheadingTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource MonoValueTextStyle}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="AudioLevelPercent" StringFormat="{}{0}%" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Level bar: fill column is proportional to AudioLevelPercent;
                                         the remainder column absorbs the leftover space so the
                                         track stays full-width at every level. -->
                                    <Border Height="10"
                                            Background="{StaticResource ThemeSurface2}"
                                            CornerRadius="5"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding AudioLevelPercent, Converter={StaticResource PercentToGridLengthConverter}}" />
                                                <ColumnDefinition Width="{Binding AudioLevelPercent, Converter={StaticResource PercentToGridLengthConverter}, ConverterParameter=Remainder}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource ThemeAccent}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </controls:CardBorder>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ AUDIO VIEW ═══ -->
                <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=Audio}"
                      Margin="20,16,20,12">
                    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <Grid MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ── CODEC SELECTION CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SettingsCodec}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="{DynamicResource CodecAuto}"
                                                Command="{Binding SelectCodecCommand}"
                                                CommandParameter="{x:Static models:PreferredCodec.Auto}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Codec}" Value="{x:Static models:PreferredCodec.Auto}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource CodecSBC}"
                                                Command="{Binding SelectCodecCommand}"
                                                CommandParameter="{x:Static models:PreferredCodec.SBC}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Codec}" Value="{x:Static models:PreferredCodec.SBC}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource CodecAAC}"
                                                Command="{Binding SelectCodecCommand}"
                                                CommandParameter="{x:Static models:PreferredCodec.AAC}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Codec}" Value="{x:Static models:PreferredCodec.AAC}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource CodecAptX}"
                                                Command="{Binding SelectCodecCommand}"
                                                CommandParameter="{x:Static models:PreferredCodec.AptX}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Codec}" Value="{x:Static models:PreferredCodec.AptX}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource CodecLDAC}"
                                                Command="{Binding SelectCodecCommand}"
                                                CommandParameter="{x:Static models:PreferredCodec.LDAC}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Codec}" Value="{x:Static models:PreferredCodec.LDAC}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                     </WrapPanel>
                                </StackPanel>
                            </controls:CardBorder>

                            <!-- ── BITRATE CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Grid.Row="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SettingsBitrate}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="Auto"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="Auto"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="Auto">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="128k"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="128k"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="128k">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="256k"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="256k"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="256k">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="320k"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="320k"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="320k">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="512k"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="512k"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="512k">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="990k"
                                                Command="{Binding SelectBitrateCommand}"
                                                CommandParameter="990k"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.Bitrate}" Value="990k">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                     </WrapPanel>
                                </StackPanel>
                            </controls:CardBorder>

                            <!-- ── SAMPLE RATE CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Grid.Row="2" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SettingsSampleRate}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="44100 Hz"
                                                Command="{Binding SelectSampleRateCommand}"
                                                CommandParameter="44100"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.SampleRate}" Value="44100">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="48000 Hz"
                                                Command="{Binding SelectSampleRateCommand}"
                                                CommandParameter="48000"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.SampleRate}" Value="48000">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                     </WrapPanel>
                                </StackPanel>
                            </controls:CardBorder>

                            <!-- ── TRANSMISSION MODE CARD ── -->
                            <controls:CardBorder Style="{StaticResource CardBorderStyle}" Grid.Row="3" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SettingsTransmission}"
                                               Style="{StaticResource SubheadingTextStyle}"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="{DynamicResource ModeBalanced}"
                                                Command="{Binding SelectTransmissionModeCommand}"
                                                CommandParameter="{x:Static models:TransmissionMode.Balanced}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.TransmissionMode}" Value="{x:Static models:TransmissionMode.Balanced}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource ModeBestQuality}"
                                                Command="{Binding SelectTransmissionModeCommand}"
                                                CommandParameter="{x:Static models:TransmissionMode.BestQuality}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.TransmissionMode}" Value="{x:Static models:TransmissionMode.BestQuality}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource ModeLowLatency}"
                                                Command="{Binding SelectTransmissionModeCommand}"
                                                CommandParameter="{x:Static models:TransmissionMode.LowLatency}"
                                                Margin="0,0,8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OptionChipStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodecSettings.TransmissionMode}" Value="{x:Static models:TransmissionMode.LowLatency}">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
                                                            <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                     </WrapPanel>
                                </StackPanel>
                            </controls:CardBorder>

<!-- ── QUALITY GUIDE CARD ──
                                  Informational hint panel — visually distinct from the
                                  adjustable parameter cards above: flat surface, left
                                  accent rail, badge label, no drop shadow. -->
                            <Border Grid.Row="4"
                                    Background="{StaticResource ThemeSurfaceAlt}"
                                    BorderBrush="{StaticResource ThemeBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left accent rail -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource ThemeAccent}"
                                            CornerRadius="2"
                                            Margin="0,16,0,16" />

                                    <StackPanel Grid.Column="1" Margin="16,14">
                                        <!-- Header: hint badge + title -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Background="{StaticResource ThemePrimaryGlass}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource QualityGuideBadge}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ThemePrimary}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource QualityGuideTitle}"
                                                       Style="{StaticResource SubheadingTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="{DynamicResource QualityGuideDesc}"
                                                   Style="{StaticResource SmallTextStyle}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18" />

                                        <Border Background="{StaticResource ThemeSurface2}"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource ThemeAccent}">
                                                    <Run Text="{DynamicResource QualityGuideSetting1}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource SmallTextStyle}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{DynamicResource QualityGuideSetting2}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{DynamicResource QualityGuideHint}"
                                                   Style="{StaticResource SmallTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0"
                                                   LineHeight="18" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ═══ SETTINGS VIEW ═══ -->
                <views:SettingsPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewTypeToVisibilityConverter}, ConverterParameter=Settings}" />

            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════
             STATUS BAR
             ════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource GlassBackgroundStrong}"
                BorderBrush="{StaticResource GlassBorder}"
                BorderThickness="0,1,0,0"
                Height="28"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status message -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Quality indicator (visible when connected) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Connection indicator bars (show connection state, not
                         signal strength — WinRT does not expose RSSI) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Height="16">
                        <Rectangle Width="3" Height="6"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                        <Rectangle Width="3" Height="10"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                        <Rectangle Width="3" Height="14"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0"
                                   Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                        <Rectangle Width="3" Height="16"
                                   RadiusX="1" RadiusY="1"
                                   VerticalAlignment="Bottom"
                                   Margin="1,0,4,0"
                                   Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}" />
                    </StackPanel>

                    <!-- Codec / quality text -->
                    <TextBlock Text="{Binding CodecDisplayText}"
                               Style="{StaticResource QualityInfoStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             AMBIENT BACKGROUND GLOW
             Subtle radial glows painted behind the content
             (non-interactive), replacing the old star field.
             ════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              IsHitTestVisible="False"
              Margin="0,40,0,0">
            <!-- Top-left ambient glow (accent) -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="1.6" ScaleY="1.6" />
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Offset="0" Color="#1E6C8CFF" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Bottom-right ambient glow (accent-secondary) -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <RadialGradientBrush.RelativeTransform>
                            <TransformGroup>
                                <ScaleTransform CenterX="1" CenterY="1" ScaleX="1.6" ScaleY="1.6" />
                            </TransformGroup>
                        </RadialGradientBrush.RelativeTransform>
                        <GradientStop Offset="0" Color="#14A78BFA" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        </Grid>
    </Border>
</Window>
