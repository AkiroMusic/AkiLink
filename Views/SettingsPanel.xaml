<UserControl x:Class="AkiLink.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AkiLink.Controls">
    <ScrollViewer Style="{StaticResource PanelScrollViewerStyle}">
        <StackPanel>

            <!-- ── Language ── -->
            <controls:CardBorder Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsLanguage}"
                               Style="{StaticResource SettingSectionStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{DynamicResource LangEn}"
                                Style="{StaticResource OptionChipStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en-US" />
                        <Button Content="{DynamicResource LangZh}"
                                Style="{StaticResource OptionChipStyle}"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="zh-CN" />
                    </StackPanel>
                </StackPanel>
            </controls:CardBorder>

            <!-- ── Auto-Reconnect ── -->
            <controls:CardBorder Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AutoReconnect}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ThemeText}" />
                        <TextBlock Text="{DynamicResource AutoReconnectDesc}"
                                   Style="{StaticResource SettingHintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding AutoReconnect}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" />
                </Grid>
            </controls:CardBorder>

            <!-- ── Close to Tray ── -->
            <controls:CardBorder Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource CloseToTray}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ThemeText}" />
                        <TextBlock Text="{DynamicResource CloseToTrayDesc}"
                                   Style="{StaticResource SettingHintStyle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding CloseToTray}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center" />
                </Grid>
            </controls:CardBorder>

        </StackPanel>
    </ScrollViewer>
</UserControl>
