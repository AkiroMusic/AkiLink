<UserControl x:Class="AkiLink.Views.HistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AkiLink.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource HistoryTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ThemeText}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="{DynamicResource ClearHistory}"
                    Style="{StaticResource GhostButtonStyle}"
                    Height="32"
                    Padding="14,0"
                    FontSize="12"
                    Command="{Binding ClearHistoryCommand}"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Visibility="{Binding HasHistory, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                Background="{StaticResource BrushTransparent}">
            <TextBlock Text="{DynamicResource HistoryEmpty}"
                       Style="{StaticResource CaptionTextStyle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </Border>

        <!-- History list -->
        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource PanelScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ConnectionHistoryEntry}">
                        <Border Style="{StaticResource HistoryItemStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Event indicator dot -->
                                <Ellipse Grid.Column="0" Style="{StaticResource HistoryEventDotStyle}" />

                                <!-- Device name + detail -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ThemeText}" />
                                    <TextBlock Text="{Binding Detail}"
                                               FontSize="11"
                                               Foreground="{StaticResource ThemeTextTertiary}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="280"
                                               Visibility="{Binding Detail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Timestamp + event type -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding TimestampFormatted}"
                                               FontSize="11"
                                               Foreground="{StaticResource ThemeTextTertiary}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource HistoryEventTypeStyle}"
                                               Text="{Binding EventType, Converter={StaticResource ConnectionEventTypeToTextConverter}}" />
                                </StackPanel>

                                <!-- Delete entry button -->
                                <Button Grid.Column="3"
                                        Content="×"
                                        Command="{Binding DataContext.DeleteHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Width="24" Height="24"
                                        Padding="0" FontSize="14"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        ToolTip="Delete" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
