<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════
         DARK THEME (Default) — "Ethereal Glass"
         bg-base: #0E1016 | surface-1: #171A23 | surface-2: #212531
         border: #2E3342 | text: #F0EEE7 | text-2: #8D93A3 | text-3: #5B606E
         accent: #6C8CFF | accent-2: #A78BFA | accent-3: #F0A0D8
         success: #4FAE8A | error: #D9695F | warning: #E8A33D
         ═══════════════════════════════════════════ -->
    <Color x:Key="DarkBackground">#0E1016</Color>
    <Color x:Key="DarkSurface">#171A23</Color>
    <Color x:Key="DarkSurface2">#212531</Color>
    <Color x:Key="DarkCard">#171A23</Color>
    <Color x:Key="DarkPrimary">#6C8CFF</Color>
    <Color x:Key="DarkAccent">#6C8CFF</Color>
    <Color x:Key="DarkAccentSecondary">#A78BFA</Color>
    <Color x:Key="DarkAccentTertiary">#F0A0D8</Color>
    <Color x:Key="DarkWarning">#E8A33D</Color>
    <Color x:Key="DarkError">#D9695F</Color>
    <Color x:Key="DarkSuccess">#4FAE8A</Color>
    <Color x:Key="DarkText">#F0EEE7</Color>
    <Color x:Key="DarkTextSecondary">#8D93A3</Color>
    <Color x:Key="DarkTextTertiary">#5B606E</Color>
    <Color x:Key="DarkBorder">#2E3342</Color>
    <Color x:Key="DarkHover">#86A3FF</Color>
    <Color x:Key="DarkPressed">#4B6EE0</Color>
    <Color x:Key="DarkSurfaceAlt">#212531</Color>
    <Color x:Key="DarkOverlay">#0B0D12</Color>

    <SolidColorBrush x:Key="ThemeBackground"        Color="{StaticResource DarkBackground}" />
    <SolidColorBrush x:Key="ThemeSurface"           Color="{StaticResource DarkSurface}" />
    <SolidColorBrush x:Key="ThemeSurface2"          Color="{StaticResource DarkSurface2}" />
    <SolidColorBrush x:Key="ThemeCard"              Color="{StaticResource DarkCard}" />
    <SolidColorBrush x:Key="ThemePrimary"           Color="{StaticResource DarkPrimary}" />
    <SolidColorBrush x:Key="ThemeAccent"            Color="{StaticResource DarkPrimary}" />
    <SolidColorBrush x:Key="ThemeAccentSecondary"   Color="{StaticResource DarkAccentSecondary}" />
    <SolidColorBrush x:Key="ThemeAccentTertiary"    Color="{StaticResource DarkAccentTertiary}" />
    <SolidColorBrush x:Key="ThemeWarning"           Color="{StaticResource DarkWarning}" />
    <SolidColorBrush x:Key="ThemeError"             Color="{StaticResource DarkError}" />
    <SolidColorBrush x:Key="ThemeSuccess"           Color="{StaticResource DarkSuccess}" />
    <SolidColorBrush x:Key="ThemeText"              Color="{StaticResource DarkText}" />
    <SolidColorBrush x:Key="ThemeTextSecondary"     Color="{StaticResource DarkTextSecondary}" />
    <SolidColorBrush x:Key="ThemeTextTertiary"      Color="{StaticResource DarkTextTertiary}" />
    <SolidColorBrush x:Key="ThemeBorder"            Color="{StaticResource DarkBorder}" />
    <SolidColorBrush x:Key="ThemeHover"             Color="{StaticResource DarkHover}" />
    <SolidColorBrush x:Key="ThemePressed"           Color="{StaticResource DarkPressed}" />
    <SolidColorBrush x:Key="ThemeSurfaceAlt"        Color="{StaticResource DarkSurfaceAlt}" />
    <SolidColorBrush x:Key="ThemeOverlay"           Color="{StaticResource DarkOverlay}" />

    <!-- Glass surfaces (Ethereal) — rgba(23,26,35,α) over bg, hairline border -->
    <SolidColorBrush x:Key="GlassBackground"        Color="#9E171A23" />  <!-- 0.62 -->
    <SolidColorBrush x:Key="GlassBackgroundStrong"  Color="#D1171A23" />  <!-- 0.82 -->
    <SolidColorBrush x:Key="GlassBorder"            Color="#14FFFFFF" />  <!-- rgba(255,255,255,0.08) -->
    <SolidColorBrush x:Key="GlassInnerLine"         Color="#14FFFFFF" />  <!-- rgba(255,255,255,0.08) -->

    <!-- Theme glass brushes (kept for compatibility, tuned to the new surface) -->
    <SolidColorBrush x:Key="ThemeSurfaceGlass"      Color="{StaticResource GlassBackground}" />
    <SolidColorBrush x:Key="ThemeCardGlass"         Color="{StaticResource GlassBackgroundStrong}" />
    <SolidColorBrush x:Key="ThemePrimaryGlass"      Color="#886C8CFF" />
    <SolidColorBrush x:Key="ThemeAccentGlass"       Color="#886C8CFF" />
    <SolidColorBrush x:Key="ThemeAccentSecondaryGlass" Color="#88A78BFA" />

    <!-- Accent tints for active pills / chips -->
    <SolidColorBrush x:Key="ThemePrimaryTint"       Color="#2E6C8CFF" />  <!-- 18% accent (Material 3 active pill) -->
    <SolidColorBrush x:Key="ThemePrimaryTintHover"  Color="#3D86A3FF" />  <!-- 24% accent-hover -->
    <SolidColorBrush x:Key="ThemeAccentSecondaryTint" Color="#1FA78BFA" />

    <!-- ═══════════════════════════════════════════
         LIGHT THEME
         ═══════════════════════════════════════════ -->
    <Color x:Key="LightBackground">#F5F5F7</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurface2">#EBEBED</Color>
    <Color x:Key="LightCard">#FFFFFF</Color>
    <Color x:Key="LightPrimary">#5B7FFF</Color>
    <Color x:Key="LightAccent">#5B7FFF</Color>
    <Color x:Key="LightAccentSecondary">#8B6FE8</Color>
    <Color x:Key="LightAccentTertiary">#D96FA8</Color>
    <Color x:Key="LightWarning">#D97706</Color>
    <Color x:Key="LightError">#FF3B30</Color>
    <Color x:Key="LightSuccess">#34C759</Color>
    <Color x:Key="LightText">#1C1C1E</Color>
    <Color x:Key="LightTextSecondary">#6C6C70</Color>
    <Color x:Key="LightTextTertiary">#AEAEB2</Color>
    <Color x:Key="LightBorder">#D1D1D6</Color>
    <Color x:Key="LightHover">#4A76F0</Color>
    <Color x:Key="LightPressed">#3A66E0</Color>
    <Color x:Key="LightSurfaceAlt">#F1F5F9</Color>
    <Color x:Key="LightOverlay">#FFFFFF</Color>

    <SolidColorBrush x:Key="LightThemeBackground"        Color="{StaticResource LightBackground}" />
    <SolidColorBrush x:Key="LightThemeSurface"           Color="{StaticResource LightSurface}" />
    <SolidColorBrush x:Key="LightThemeSurface2"          Color="{StaticResource LightSurface2}" />
    <SolidColorBrush x:Key="LightThemeCard"              Color="{StaticResource LightCard}" />
    <SolidColorBrush x:Key="LightThemePrimary"           Color="{StaticResource LightPrimary}" />
    <SolidColorBrush x:Key="LightThemeAccent"            Color="{StaticResource LightAccent}" />
    <SolidColorBrush x:Key="LightThemeAccentSecondary"   Color="{StaticResource LightAccentSecondary}" />
    <SolidColorBrush x:Key="LightThemeAccentTertiary"    Color="{StaticResource LightAccentTertiary}" />
    <SolidColorBrush x:Key="LightThemeWarning"           Color="{StaticResource LightWarning}" />
    <SolidColorBrush x:Key="LightThemeError"             Color="{StaticResource LightError}" />
    <SolidColorBrush x:Key="LightThemeSuccess"           Color="{StaticResource LightSuccess}" />
    <SolidColorBrush x:Key="LightThemeText"              Color="{StaticResource LightText}" />
    <SolidColorBrush x:Key="LightThemeTextSecondary"     Color="{StaticResource LightTextSecondary}" />
    <SolidColorBrush x:Key="LightThemeTextTertiary"      Color="{StaticResource LightTextTertiary}" />
    <SolidColorBrush x:Key="LightThemeBorder"            Color="{StaticResource LightBorder}" />
    <SolidColorBrush x:Key="LightThemeHover"             Color="{StaticResource LightHover}" />
    <SolidColorBrush x:Key="LightThemePressed"           Color="{StaticResource LightPressed}" />
    <SolidColorBrush x:Key="LightThemeSurfaceAlt"        Color="{StaticResource LightSurfaceAlt}" />
    <SolidColorBrush x:Key="LightThemeOverlay"           Color="{StaticResource LightOverlay}" />

    <!-- ═══════════════════════════════════════════
         STATUS COLORS (Shared across themes)
         ═══════════════════════════════════════════ -->
    <Color x:Key="ConnectedGreen">#22C55E</Color>
    <Color x:Key="DisconnectedGray">#6B7280</Color>
    <Color x:Key="ConnectingOrange">#F59E0B</Color>

    <SolidColorBrush x:Key="BrushStatusConnected"        Color="{StaticResource ConnectedGreen}" />
    <SolidColorBrush x:Key="BrushStatusDisconnected"     Color="{StaticResource DisconnectedGray}" />
    <SolidColorBrush x:Key="BrushStatusConnecting"       Color="{StaticResource ConnectingOrange}" />
    <SolidColorBrush x:Key="StatusConnectedGlow"    Color="#4422C55E" />
    <SolidColorBrush x:Key="StatusConnectingGlow"   Color="#44F59E0B" />

    <!-- ═══════════════════════════════════════════
         SHARED UTILITY COLORS
         ═══════════════════════════════════════════ -->
    <Color x:Key="PureWhite">#FFFFFF</Color>
    <Color x:Key="PureBlack">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

    <SolidColorBrush x:Key="BrushWhite"             Color="{StaticResource PureWhite}" />
    <SolidColorBrush x:Key="BrushBlack"             Color="{StaticResource PureBlack}" />
    <SolidColorBrush x:Key="BrushTransparent"       Color="{StaticResource Transparent}" />

    <!-- Shadows: layered, tinted with deep blue rgba(4,6,12,α) per spec -->
    <SolidColorBrush x:Key="ShadowColor"            Color="#4004060C" />
    <SolidColorBrush x:Key="ShadowColorLight"       Color="#2004060C" />
    <SolidColorBrush x:Key="GlowColorPrimary"       Color="#336C8CFF" />
    <SolidColorBrush x:Key="GlowColorAccent"        Color="#336C8CFF" />
</ResourceDictionary>
