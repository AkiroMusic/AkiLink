<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════
         BASE / GLOBAL STYLES
         ═══════════════════════════════════════════ -->

    <!-- Default text style for the application -->
    <Style TargetType="TextElement">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
    </Style>

    <!-- ═══════════════════════════════════════════
         WINDOW STYLE
         NOTE: WindowStyle="None" and AllowsTransparency="True"
               must be set on the Window element itself.
         ═══════════════════════════════════════════ -->
    <Style TargetType="Window" x:Key="ModernWindowStyle">
        <Setter Property="Background" Value="{StaticResource ThemeBackground}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Default implicit Window style -->
    <Style TargetType="Window" BasedOn="{StaticResource ModernWindowStyle}" />

    <!-- ═══════════════════════════════════════════
         TEXTBLOCK STYLES
         ═══════════════════════════════════════════ -->
    <Style TargetType="TextBlock" x:Key="HeadingTextStyle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SubheadingTextStyle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock" x:Key="BodyTextStyle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock" x:Key="CaptionTextStyle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SmallTextStyle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <!-- Default implicit TextBlock style -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
    </Style>

    <!-- ═══════════════════════════════════════════
         CARD BORDER STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Border" x:Key="CardBorderStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCard}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="2"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass card variant with semi-transparent background -->
    <Style TargetType="Border" x:Key="GlassCardStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCardGlass}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.4"
                                  Color="#000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         MODERN BUTTON STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Button" x:Key="ModernButtonStyle">
        <Setter Property="Background" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.25"
                                              Color="#000" />
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover state -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeHover}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <!-- Pressed state -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePressed}" />
                            <Setter TargetName="RootBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Disabled state -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
                        </Trigger>
                        <!-- Focus state -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush"
                                    Value="{StaticResource ThemeAccent}" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit Button style -->
    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}" />

    <!-- ═══════════════════════════════════════════
         ACCENT / SECONDARY BUTTON STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Button" x:Key="AccentButtonStyle">
        <Setter Property="Background" Value="{StaticResource ThemeAccent}" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.25"
                                              Color="#000" />
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                            <Setter TargetName="RootBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         OUTLINE / GHOST BUTTON STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Button" x:Key="GhostButtonStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePrimaryGlass}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePrimary}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush"
                                    Value="{StaticResource ThemeTextSecondary}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         CONNECT / DISCONNECT LARGE BUTTONS
         ═══════════════════════════════════════════ -->
    <Style TargetType="Button" x:Key="ConnectButtonStyle">
        <Setter Property="Background" Value="{StaticResource ThemeAccent}" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="2"
                                              Direction="270"
                                              Opacity="0.35"
                                              Color="#000" />
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.8" />
                            <Setter TargetName="RootBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="DisconnectButtonStyle">
        <Setter Property="Background" Value="{StaticResource ThemeError}" />
        <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="2"
                                              Direction="270"
                                              Opacity="0.35"
                                              Color="#000" />
                        </Border.Effect>
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.8" />
                            <Setter TargetName="RootBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         SLIDER STYLE
         Minimal modern track with accent thumb
         ═══════════════════════════════════════════ -->
    <!-- Slider thumb template (standalone) -->
    <ControlTemplate x:Key="SliderThumbControlTemplate" TargetType="Thumb">
        <Ellipse x:Name="ThumbEllipse"
                  Width="16"
                  Height="16"
                  Fill="{StaticResource ThemePrimary}"
                  Stroke="{StaticResource BrushWhite}"
                  StrokeThickness="2"
                  SnapsToDevicePixels="True">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="6"
                                  ShadowDepth="1"
                                  Opacity="0.3"
                                  Color="#000" />
            </Ellipse.Effect>
        </Ellipse>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbEllipse"
                        Property="Width" Value="20" />
                <Setter TargetName="ThumbEllipse"
                        Property="Height" Value="20" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbEllipse"
                        Property="Width" Value="18" />
                <Setter TargetName="ThumbEllipse"
                        Property="Height" Value="18" />
                <Setter TargetName="ThumbEllipse"
                        Property="Fill"
                        Value="{StaticResource ThemeAccent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Slider track button style (invisible repeat buttons) -->
    <Style TargetType="RepeatButton" x:Key="SliderTrackButtonStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" x:Key="ModernSliderStyle">
        <Setter Property="Height" Value="32" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="GridRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" MinHeight="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Track background — declared BEFORE the Track so it renders BEHIND
                             the Thumb (WPF paints later siblings on top). Without this, the
                             4px bar draws across the middle of the 16px Thumb circle. -->
                        <Rectangle x:Name="TrackBackground"
                                   Grid.Row="1"
                                   Height="4"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Fill="{StaticResource ThemeBorder}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />

                        <!-- Track (handles positioning and value binding automatically).
                             NOTE: full-height click target (32px) so clicking the track
                             anywhere near the bar works; the visual bar is the 4px
                             TrackBackground above. Keep the Thumb vertically centered. -->
                        <Track x:Name="PART_Track"
                               Grid.Row="1"
                               VerticalAlignment="Center"
                               Height="32">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              Style="{StaticResource SliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Width="16"
                                       Height="16"
                                       Focusable="False"
                                       Template="{StaticResource SliderThumbControlTemplate}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="PART_Track" Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="Width" Value="4" />
                            <Setter TargetName="TrackBackground" Property="Width" Value="4" />
                            <Setter TargetName="TrackBackground" Property="Height" Value="Auto" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.4" />
                            <Setter TargetName="TrackBackground" Property="Fill"
                                    Value="{StaticResource ThemeTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit Slider style -->
    <Style TargetType="Slider" BasedOn="{StaticResource ModernSliderStyle}" />

    <!-- ═══════════════════════════════════════════
         TOGGLE SWITCH STYLE
         Modern pill-shaped toggle (based on ToggleButton)
         ═══════════════════════════════════════════ -->
    <Style TargetType="ToggleButton" x:Key="ToggleSwitchStyle">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid">
                        <!-- Track -->
                        <Border x:Name="TrackBorder"
                                Width="44"
                                Height="24"
                                CornerRadius="12"
                                Background="{StaticResource ThemeBorder}"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="1"
                                                  Opacity="0.2"
                                                  Color="#000" />
                            </Border.Effect>
                        </Border>

                        <!-- Thumb (circle) - position controlled by Margin -->
                        <Ellipse x:Name="ThumbEllipse"
                                 Width="18"
                                 Height="18"
                                 Fill="{StaticResource ThemeTextSecondary}"
                                 Stroke="{StaticResource BrushWhite}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="3,0,0,0"
                                 SnapsToDevicePixels="True">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="1"
                                                  Opacity="0.3"
                                                  Color="#000" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackBorder" Property="Background"
                                    Value="{StaticResource ThemePrimary}" />
                            <Setter TargetName="ThumbEllipse" Property="Fill"
                                    Value="{StaticResource BrushWhite}" />
                            <Setter TargetName="ThumbEllipse" Property="Margin"
                                    Value="23,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbEllipse" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootGrid" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="TrackBorder" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         LISTBOX STYLE
         Transparent background, card-style items
         ═══════════════════════════════════════════ -->
    <!-- ListBox base style -->
    <Style TargetType="ListBox" x:Key="ModernListBoxStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer x:Name="ScrollViewer"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  Focusable="False">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit ListBox style -->
    <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBoxStyle}" />

    <!-- ListBoxItem style - card-like items -->
    <Style TargetType="ListBoxItem" x:Key="ModernListBoxItemStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCard}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="1"
                                              Direction="270"
                                              Opacity="0.2"
                                              Color="#000" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeHover}" />
                        </Trigger>
                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePrimaryGlass}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush"
                                    Value="{StaticResource ThemePrimary}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                        </Trigger>
                        <!-- Focus -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePrimaryGlass}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush"
                                    Value="{StaticResource ThemePrimary}" />
                        </MultiTrigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit ListBoxItem style -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}" />

    <Style TargetType="RepeatButton" x:Key="ScrollBarButtonStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Thumb" x:Key="ScrollBarThumbStyle">
        <Setter Property="Background" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemePrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal scrollbar style -->
    <Style TargetType="ScrollBar" x:Key="ModernScrollBarStyle">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track"
                               Grid.Row="1"
                               IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="6" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         SCROLLVIEWER STYLE
         Minimal dark scrollbars
         ═══════════════════════════════════════════ -->
    <Style TargetType="ScrollViewer" x:Key="ModernScrollViewerStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="ScrollContentPresenter"
                                                 Grid.Row="0"
                                                 Grid.Column="0"
                                                 CanContentScroll="{TemplateBinding CanContentScroll}"
                                                 CanHorizontallyScroll="True"
                                                 CanVerticallyScroll="True"
                                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                                 Content="{TemplateBinding Content}"
                                                 Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding Path=VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Cursor="Arrow"
                                   Style="{StaticResource ModernScrollBarStyle}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Orientation="Horizontal"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding Path=HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Cursor="Arrow"
                                    Style="{StaticResource ModernScrollBarStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         TOOLTIP STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="ToolTip" x:Key="ModernToolTipStyle">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              ShadowDepth="2"
                                              Opacity="0.4"
                                              Color="#000" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit ToolTip style -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource ModernToolTipStyle}" />

    <!-- ═══════════════════════════════════════════
         SEPARATOR STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Separator" x:Key="ModernSeparatorStyle">
        <Setter Property="Background" Value="{StaticResource ThemeBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Fill="{TemplateBinding Background}"
                               Height="{TemplateBinding Height}"
                               Margin="{TemplateBinding Margin}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit Separator style -->
    <Style TargetType="Separator" BasedOn="{StaticResource ModernSeparatorStyle}" />

    <!-- ═══════════════════════════════════════════
         STATUS INDICATOR TEMPLATES
         ═══════════════════════════════════════════ -->

    <!-- Connected status indicator (green circle with glow) -->
    <Style TargetType="Ellipse" x:Key="StatusConnectedIndicator">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="{StaticResource BrushStatusConnected}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.8"
                                  Color="{StaticResource ConnectedGreen}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disconnected status indicator (gray circle) -->
    <Style TargetType="Ellipse" x:Key="StatusDisconnectedIndicator">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="{StaticResource BrushStatusDisconnected}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Connecting status indicator (orange circle with glow) -->
    <Style TargetType="Ellipse" x:Key="StatusConnectingIndicator">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Fill" Value="{StaticResource BrushStatusConnecting}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0.8"
                                  Color="{StaticResource ConnectingOrange}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════
         STATUS BAR / CONTAINER STYLES
         ═══════════════════════════════════════════ -->

    <!-- Status bar at the bottom of the window -->
    <Style TargetType="Border" x:Key="StatusBarStyle">
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- ═══════════════════════════════════════════
         LABEL STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="Label" x:Key="ModernLabelStyle">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="0,0,0,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Default implicit Label style -->
    <Style TargetType="Label" BasedOn="{StaticResource ModernLabelStyle}" />

    <!-- ═══════════════════════════════════════════
         GROUPBOX STYLE
         ═══════════════════════════════════════════ -->
    <Style TargetType="GroupBox" x:Key="ModernGroupBoxStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{StaticResource ThemeSurfaceAlt}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0"
                                Padding="12,6">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.FontSize="13" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Top"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default implicit GroupBox style -->
    <Style TargetType="GroupBox" BasedOn="{StaticResource ModernGroupBoxStyle}" />

    <!-- ═══════════════════════════════════════════
         SIDEBAR NAVIGATION STYLES
         ═══════════════════════════════════════════ -->

    <!-- Sidebar container -->
    <Style TargetType="Border" x:Key="SidebarStyle">
        <Setter Property="Width" Value="68" />
        <Setter Property="MinWidth" Value="68" />
        <Setter Property="Background" Value="{StaticResource ThemeSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Sidebar nav button - supports both icons and icon+text content -->
    <Style TargetType="Button" x:Key="SidebarButtonStyle">
        <Setter Property="Width" Value="68" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <!-- Active indicator bar -->
                        <Border x:Name="ActiveBar"
                                Width="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Margin="0,4,0,4"
                                CornerRadius="0,2,2,0"
                                Background="{StaticResource ThemePrimary}"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootGrid" Property="Background"
                                    Value="{StaticResource ThemeSurface2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootGrid" Property="Background"
                                    Value="{StaticResource ThemeBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar nav button - active state applied via tag or attached property -->
    <Style TargetType="Button" x:Key="SidebarButtonActiveStyle"
           BasedOn="{StaticResource SidebarButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════
         OPTION CHIP STYLES
         Pill/toggle buttons for codec, bitrate, etc.
         ═══════════════════════════════════════════ -->

    <Style TargetType="Button" x:Key="OptionChipStyle">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="BorderBrush"
                                    Value="{StaticResource ThemeTextSecondary}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource ThemeText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeSurface2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active/selected option chip -->
    <Style TargetType="Button" x:Key="OptionChipActiveStyle"
           BasedOn="{StaticResource OptionChipStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource ThemePrimary}" />
        <Setter Property="Background" Value="{StaticResource ThemePrimaryGlass}" />
        <Setter Property="Foreground" Value="{StaticResource ThemePrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ═══════════════════════════════════════════
         SETTINGS SECTION STYLES
         ═══════════════════════════════════════════ -->

    <!-- Settings section heading -->
    <Style TargetType="TextBlock" x:Key="SettingSectionStyle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Settings section description / hint -->
    <Style TargetType="TextBlock" x:Key="SettingHintStyle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextTertiary}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Settings value label (for slider values etc.) -->
    <Style TargetType="TextBlock" x:Key="SettingValueStyle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ═══════════════════════════════════════════
         HISTORY ITEM STYLES
         ═══════════════════════════════════════════ -->

    <Style TargetType="Border" x:Key="HistoryItemStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- History event dot (colored indicator) -->
    <Style TargetType="Ellipse" x:Key="HistoryEventDotStyle">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Fill" Value="{StaticResource ThemeTextTertiary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding EventType}" Value="Connected">
                <Setter Property="Fill" Value="{StaticResource BrushStatusConnected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EventType}" Value="Disconnected">
                <Setter Property="Fill" Value="{StaticResource BrushStatusDisconnected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EventType}" Value="Error">
                <Setter Property="Fill" Value="{StaticResource ThemeError}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- History event type label -->
    <Style TargetType="TextBlock" x:Key="HistoryEventTypeStyle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextTertiary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding EventType}" Value="Connected">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusConnected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EventType}" Value="Disconnected">
                <Setter Property="Foreground" Value="{StaticResource BrushStatusDisconnected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EventType}" Value="Error">
                <Setter Property="Foreground" Value="{StaticResource ThemeError}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════
         SECTION CARD (for settings/options grouping)
         ═══════════════════════════════════════════ -->

    <Style TargetType="Border" x:Key="SectionCardStyle">
        <Setter Property="Background" Value="{StaticResource ThemeCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════
          PANEL CONTAINER (scrollable content area)
          ═══════════════════════════════════════════ -->

    <Style TargetType="ScrollViewer" x:Key="PanelScrollViewerStyle">
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ═══════════════════════════════════════════
         QUALITY / SIGNAL INDICATOR STYLES
         ═══════════════════════════════════════════ -->

    <!-- Container for signal strength bars -->
    <Style TargetType="StackPanel" x:Key="SignalBarsStyle">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Individual signal bar (rectangle, width varies per bar) -->
    <Style TargetType="Rectangle" x:Key="SignalBarStyle">
        <Setter Property="Width" Value="3" />
        <Setter Property="RadiusX" Value="1" />
        <Setter Property="RadiusY" Value="1" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Fill" Value="{StaticResource ThemeBorder}" />
    </Style>

    <!-- Quality info text in status bar -->
    <Style TargetType="TextBlock" x:Key="QualityInfoStyle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <!-- ═══════════════════════════════════════════
         WINDOW CONTROL BUTTON STYLES
         For custom title bar minimize/maximize/close
         ═══════════════════════════════════════════ -->

    <!-- Base style for window caption buttons (minimize/maximize) -->
    <Style TargetType="Button" x:Key="WindowControlButtonStyle">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource BrushTransparent}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeSurface2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="{StaticResource ThemeBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button style — red hover like Windows 11 -->
    <Style TargetType="Button" x:Key="WindowCloseButtonStyle"
           BasedOn="{StaticResource WindowControlButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background"
                                    Value="#F1707A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
